// Template → bootstrap writes wrangler.jsonc (gitignored) with YOUR resource ids filled in.
// Bindings are declared PER ENVIRONMENT and never inherited (a Cloudflare footgun).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__NAME__-daily-card",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "env": {
    "local": {
      "name": "__NAME__-daily-card-local",
      "vars": { "ENVIRONMENT": "local", "AI_GATEWAY_BASE_URL": "" },
      "d1_databases": [{ "binding": "CARDS", "database_name": "cards-local", "database_id": "local", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "local-config" }],
      "triggers": { "crons": [] }
    },
    "__STAGE__": {
      "name": "__NAME__-daily-card-__STAGE__",
      "vars": { "ENVIRONMENT": "__STAGE__", "AI_GATEWAY_BASE_URL": "__AI_GATEWAY_BASE_URL__" },
      "d1_databases": [{ "binding": "CARDS", "database_name": "__CARDS_D1_NAME__", "database_id": "__CARDS_D1_ID__", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "__CONFIG_KV_ID__" }],
      "triggers": { "crons": ["0 1 * * *"] }
    }
  }
}
