# Karkhana — every external dependency, user-supplied. Copy to .env (gitignored). Nothing here
# points at anyone else's account. `npm run doctor` reads this file and tells you what is missing.

# ── REQUIRED — your Cloudflare account ───────────────────────────────────────────────────────
# Scoped API token: Account → Workers Scripts:Edit · D1:Edit · Workers KV Storage:Edit · Workers R2
# Storage:Edit · Queues:Edit · AI Gateway:Edit · Workers AI:Edit · Account Settings:Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Name prefix for every resource (d1/kv/r2/queue/gateway/workers). Lowercase, dashes.
KARKHANA_NAME=karkhana
# One stage per .env. bootstrap deploys `staging`; prod needs --prod --i-know (see tasks/deploy-prod.md).
KARKHANA_STAGE=staging
# Passphrase Alchemy uses to encrypt secrets in its local state. Any strong string; keep it stable.
ALCHEMY_PASSWORD=

# ── OPTIONAL — model providers (default roles run on Workers AI through YOUR AI Gateway) ──────
# Add any of these to unlock that provider; switch a role in KV (tasks/switch-a-model-role.md).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
COHERE_API_KEY=

# ── OPTIONAL — observability / search / MCP ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TAVILY_API_KEY=
GITHUB_TOKEN=
