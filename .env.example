# Namaste Ji Boilerplate — every external dependency, user-supplied. Copy to .env (gitignored). Nothing here
# points at anyone else's account. `npm run doctor` reads this file and tells you what is missing.

# ── REQUIRED — your Cloudflare account ───────────────────────────────────────────────────────
# Scoped API token: Account → Workers Scripts:Edit · D1:Edit · Workers KV Storage:Edit ·
# AI Gateway:Edit · Workers AI:Edit · Account Settings:Read.
# Add R2 Storage:Edit / Queues:Edit only if you turn those on below.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Name prefix for every resource (d1/kv/r2/queue/gateway/workers). Lowercase, dashes.
PROJECT_NAME=my-app
# One stage per .env. bootstrap deploys `staging`; prod needs --prod --i-know (see tasks/deploy-prod.md).
PROJECT_STAGE=staging

# ── OPTIONAL — safety & extra resources ──────────────────────────────────────────────────────
# OPTIONAL. Passphrase Alchemy uses to encrypt secrets in its local state. `npm run bootstrap`
# generates one into .env on first run — set it by hand only if you want to choose it yourself.
# Whatever it ends up as, keep it stable: it decrypts your existing state.
ALCHEMY_PASSWORD=

# OPTIONAL but recommended. The Worker only needs Workers AI. If you leave this empty it receives
# your full provisioning token above, which can rewrite the whole account — a narrow
# Workers AI:Edit-only token here is least privilege.
CF_WORKERS_AI_TOKEN=

# OPTIONAL extra resources. Neither is bound by the example. Queues need a Workers PAID plan, so
# they are off by default — a free-plan bootstrap would otherwise fail on something unused.
PROVISION_R2=
PROVISION_QUEUE=

# ── OPTIONAL — model providers (default roles run on Workers AI through YOUR AI Gateway) ──────
# Add any of these to unlock that provider; switch a role in KV (tasks/switch-a-model-role.md).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
COHERE_API_KEY=

# ── OPTIONAL — observability / search / MCP ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TAVILY_API_KEY=
GITHUB_TOKEN=
